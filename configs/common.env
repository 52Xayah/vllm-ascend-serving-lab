# 共享配置：所有实例共用。
# 注意：不要在此写入密码、token、IP 等敏感信息。

# ---- 昇腾运行环境 ----
ASCEND_TOOLKIT_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
ASCEND_ATB_ENV=/usr/local/Ascend/nnal/atb/set_env.sh
ASCEND_DRIVER_LIB_DIR=/usr/local/Ascend/driver/lib64
PYTHON_BIN_DIR=/usr/local/python3.12.13/bin

# ---- 模型与缓存 ----
MODEL=Qwen/Qwen3-4B
SERVED_MODEL_NAME=qwen-dspark
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/workspace/qwen-dspark-online/hf-cache

# ---- vLLM 服务参数 ----
HOST=127.0.0.1
TENSOR_PARALLEL_SIZE=1
DTYPE=bfloat16
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.8
SEED=42
# 与原指导书一致的固定开关；按空格切分
VLLM_EXTRA_ARGS="--enforce-eager --no-async-scheduling --no-enable-prefix-caching"
# DSpark 投机解码配置（JSON）
SPECULATIVE_CONFIG='{"method":"dspark","model":"deepseek-ai/dspark_qwen3_4b_block7","num_speculative_tokens":7,"enforce_eager":true}'

# ---- 运行时环境变量 ----
OMP_NUM_THREADS=1
PYTORCH_NPU_ALLOC_CONF=expandable_segments:True
